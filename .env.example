# ─────────────────────────────────────────────────────────────────────────────
# FitCore AI — environment variables (copy to .env.local and fill in)
#
# The app RUNS with none of these set (dev-auth fallback, in-memory store, and a
# deterministic AI mock). Each integration "lights up" the moment its key is added
# and the server is restarted. See docs/architecture/13-vercel-deployment.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used for OpenGraph/metadata + absolute links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (authentication) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (primary app persistence for Clerk-keyed profiles)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Vercel / normal networks — SRV form:
#   mongodb+srv://<user>:<pw>@cluster0.auscyft.mongodb.net/?retryWrites=true&w=majority
# Sandboxes where Node can't resolve SRV — non-SRV form:
#   mongodb://<user>:<pw>@host0:27017,host1:27017,host2:27017/?ssl=true&replicaSet=<rs>&authSource=admin
# If unset, the app uses an in-memory store (data resets on restart) so it stays runnable offline.
MONGODB_URI=
MONGODB_DB=fitcore

# ── AI providers ─────────────────────────────────────────────────────────────
# The registry (lib/ai/registry.ts) picks the first AVAILABLE provider in this order:
#   AI_PROVIDER_<TASK>  >  AI_PROVIDER  >  gemini > openai > claude  >  mock (offline)
# Add ANY one key below to go live; with none set, the deterministic mock keeps everything working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional global override (gemini | openai | claude | mock):
# AI_PROVIDER=openai
# Optional per-task override — task names: COACH_CHAT, PLAN_JSON, NUDGE, WEEKLY_STORY, MEAL_VISION, INSIGHT
# AI_PROVIDER_PLAN_JSON=openai
# AI_PROVIDER_COACH_CHAT=claude

# ── WhatsApp (Meta Cloud API) — activates when token + phone id are set ────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Must match the "Verify token" you set in the Meta webhook dashboard:
WHATSAPP_VERIFY_TOKEN=

# ── Storage (progress photos, etc.) — choose one ──────────────────────────────
CLOUDINARY_URL=
# or Vercel Blob:
BLOB_READ_WRITE_TOKEN=

# ── Payments (subscriptions) ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email + rate limiting ─────────────────────────────────────────────────────
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
